<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CyberSec // Abhijeet Kumar Ray</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Exo+2:wght@300;400;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --green: #00ff41;
    --green-dim: #00c832;
    --green-glow: rgba(0,255,65,0.15);
    --cyan: #00e5ff;
    --red: #ff003c;
    --bg: #020c02;
    --bg2: #040f04;
    --panel: rgba(0,255,65,0.04);
    --border: rgba(0,255,65,0.18);
    --text: #b0ffb8;
    --mono: 'Share Tech Mono', monospace;
    --display: 'Orbitron', sans-serif;
    --body: 'Exo 2', sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--body);
    overflow-x: hidden;
    cursor: none;
  }

  /* CUSTOM CURSOR */
  .cursor {
    position: fixed;
    width: 20px; height: 20px;
    border: 1.5px solid var(--green);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%,-50%);
    transition: transform 0.1s, width 0.2s, height 0.2s, background 0.2s;
    mix-blend-mode: screen;
  }
  .cursor-dot {
    position: fixed;
    width: 4px; height: 4px;
    background: var(--green);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%,-50%);
  }

  /* MATRIX CANVAS */
  #matrix-bg {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    opacity: 0.13;
  }

  /* SCAN LINE */
  body::after {
    content: '';
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.08) 2px,
      rgba(0,0,0,0.08) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 48px;
    border-bottom: 1px solid var(--border);
    background: rgba(2,12,2,0.85);
    backdrop-filter: blur(12px);
  }
  .nav-logo {
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 900;
    color: var(--green);
    letter-spacing: 4px;
    text-transform: uppercase;
  }
  .nav-logo span { color: var(--cyan); }
  .nav-links { display: flex; gap: 36px; list-style: none; }
  .nav-links a {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: color 0.2s;
    position: relative;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px; left: 0;
    width: 0; height: 1px;
    background: var(--green);
    transition: width 0.3s;
  }
  .nav-links a:hover { color: var(--green); }
  .nav-links a:hover::after { width: 100%; }

  /* HERO */
  .hero {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 10vw;
  }
  .hero-tag {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--green);
    letter-spacing: 4px;
    margin-bottom: 16px;
    opacity: 0;
    animation: fadeUp 0.6s 0.3s forwards;
  }
  .hero h1 {
    font-family: var(--display);
    font-size: clamp(2.5rem, 7vw, 6rem);
    font-weight: 900;
    line-height: 1.05;
    color: #fff;
    text-shadow: 0 0 40px rgba(0,255,65,0.3);
    opacity: 0;
    animation: fadeUp 0.6s 0.5s forwards;
  }
  .hero h1 .accent { color: var(--green); }
  .hero h1 .accent2 { color: var(--cyan); }
  .hero-sub {
    font-family: var(--mono);
    font-size: clamp(0.85rem, 1.5vw, 1.1rem);
    color: var(--text);
    margin-top: 20px;
    max-width: 560px;
    line-height: 1.8;
    opacity: 0;
    animation: fadeUp 0.6s 0.7s forwards;
  }
  .hero-sub .typed-cursor { color: var(--green); animation: blink 0.8s infinite; }
  .hero-btns {
    display: flex;
    gap: 16px;
    margin-top: 40px;
    opacity: 0;
    animation: fadeUp 0.6s 0.9s forwards;
  }
  .btn {
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 14px 32px;
    border: 1px solid var(--green);
    background: transparent;
    color: var(--green);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }
  .btn::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: var(--green);
    transition: left 0.25s;
    z-index: -1;
  }
  .btn:hover { color: #000; }
  .btn:hover::before { left: 0; }
  .btn-ghost {
    border-color: rgba(0,255,65,0.3);
    color: var(--text);
  }
  .btn-ghost:hover { border-color: var(--cyan); color: #000; }
  .btn-ghost::before { background: var(--cyan); }

  /* TERMINAL WINDOW */
  .terminal-float {
    position: absolute;
    right: 6vw;
    top: 50%;
    transform: translateY(-50%);
    width: 360px;
    background: rgba(4,15,4,0.92);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 0 60px rgba(0,255,65,0.1), 0 0 0 1px rgba(0,255,65,0.05);
    opacity: 0;
    animation: fadeUp 0.8s 1.1s forwards;
  }
  .terminal-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(0,255,65,0.04);
  }
  .t-dot { width: 10px; height: 10px; border-radius: 50%; }
  .t-dot.r { background: #ff5f56; }
  .t-dot.y { background: #ffbd2e; }
  .t-dot.g { background: #27c93f; }
  .terminal-title { font-family: var(--mono); font-size: 0.7rem; color: rgba(176,255,184,0.5); margin-left: auto; }
  .terminal-body { padding: 16px; font-family: var(--mono); font-size: 0.75rem; line-height: 2; }
  .t-line { display: flex; gap: 8px; }
  .t-prompt { color: var(--green); }
  .t-cmd { color: #fff; }
  .t-out { color: rgba(176,255,184,0.6); padding-left: 16px; }
  .t-out.cyan { color: var(--cyan); }
  .t-out.red { color: var(--red); }
  .t-cursor { display: inline-block; width: 8px; height: 14px; background: var(--green); animation: blink 0.8s infinite; vertical-align: middle; }

  /* SECTION COMMON */
  section { position: relative; z-index: 2; padding: 100px 10vw; }
  .section-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 5px;
    color: var(--green);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .section-label::before { content: '// '; }
  .section-title {
    font-family: var(--display);
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 60px;
    text-shadow: 0 0 20px rgba(0,255,65,0.2);
  }
  .divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  /* SKILLS GRID */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }
  .skill-card {
    border: 1px solid var(--border);
    background: var(--panel);
    padding: 28px 24px;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }
  .skill-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 3px; height: 0;
    background: var(--green);
    transition: height 0.3s;
  }
  .skill-card:hover { border-color: var(--green); background: rgba(0,255,65,0.07); transform: translateY(-4px); box-shadow: 0 20px 40px rgba(0,255,65,0.08); }
  .skill-card:hover::before { height: 100%; }
  .skill-icon { font-size: 1.8rem; margin-bottom: 14px; }
  .skill-name { font-family: var(--display); font-size: 0.85rem; font-weight: 700; letter-spacing: 2px; color: #fff; margin-bottom: 8px; }
  .skill-desc { font-size: 0.82rem; color: rgba(176,255,184,0.6); line-height: 1.6; }
  .skill-bar-wrap { margin-top: 16px; background: rgba(0,255,65,0.08); height: 3px; }
  .skill-bar { height: 3px; background: linear-gradient(90deg, var(--green), var(--cyan)); transition: width 1s ease; }

  /* PROJECTS */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }
  .project-card {
    border: 1px solid var(--border);
    background: var(--panel);
    padding: 32px;
    transition: all 0.3s;
    position: relative;
  }
  .project-card:hover { border-color: var(--cyan); box-shadow: 0 0 30px rgba(0,229,255,0.08); transform: translateY(-4px); }
  .project-num { font-family: var(--mono); font-size: 0.7rem; color: var(--green); margin-bottom: 16px; opacity: 0.6; }
  .project-title { font-family: var(--display); font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 12px; letter-spacing: 1px; }
  .project-desc { font-size: 0.83rem; color: rgba(176,255,184,0.6); line-height: 1.7; margin-bottom: 20px; }
  .project-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 1px;
    padding: 4px 10px;
    border: 1px solid rgba(0,255,65,0.25);
    color: var(--green);
  }

  /* ABOUT */
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .about-text p { font-size: 0.92rem; line-height: 1.9; color: rgba(176,255,184,0.75); margin-bottom: 16px; }
  .about-text p span { color: var(--green); }
  .about-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .stat-box {
    border: 1px solid var(--border);
    padding: 24px;
    background: var(--panel);
    text-align: center;
  }
  .stat-num { font-family: var(--display); font-size: 2rem; font-weight: 900; color: var(--green); }
  .stat-label { font-family: var(--mono); font-size: 0.68rem; letter-spacing: 2px; color: rgba(176,255,184,0.5); margin-top: 4px; }

  /* CONTACT */
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }
  .contact-info p { font-family: var(--mono); font-size: 0.82rem; color: rgba(176,255,184,0.65); line-height: 2; }
  .contact-info a { color: var(--green); text-decoration: none; }
  .contact-form { display: flex; flex-direction: column; gap: 16px; }
  .form-input {
    background: var(--panel);
    border: 1px solid var(--border);
    padding: 14px 18px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.82rem;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }
  .form-input:focus { border-color: var(--green); box-shadow: 0 0 10px rgba(0,255,65,0.1); }
  .form-input::placeholder { color: rgba(176,255,184,0.3); }
  textarea.form-input { resize: vertical; min-height: 120px; }

  /* FOOTER */
  footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--border);
    padding: 32px 10vw;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  footer p { font-family: var(--mono); font-size: 0.72rem; color: rgba(176,255,184,0.35); }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a { font-family: var(--mono); font-size: 0.72rem; color: rgba(176,255,184,0.4); text-decoration: none; transition: color 0.2s; }
  .footer-links a:hover { color: var(--green); }

  /* STATUS BAR */
  .status-bar {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(2,12,2,0.9);
    border-top: 1px solid var(--border);
    padding: 6px 48px;
    display: flex;
    gap: 32px;
    font-family: var(--mono);
    font-size: 0.65rem;
    color: rgba(176,255,184,0.4);
  }
  .status-item { display: flex; gap: 8px; align-items: center; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); animation: pulse 2s infinite; }
  .status-dot.red { background: var(--red); }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }
  @keyframes glitch {
    0% { clip-path: inset(40% 0 61% 0); transform: translate(-2px, 0); }
    20% { clip-path: inset(92% 0 1% 0); transform: translate(2px, 0); }
    40% { clip-path: inset(43% 0 1% 0); transform: translate(-2px, 0); }
    60% { clip-path: inset(25% 0 58% 0); transform: translate(2px, 0); }
    80% { clip-path: inset(54% 0 7% 0); transform: translate(-2px, 0); }
    100% { clip-path: inset(58% 0 43% 0); transform: translate(0, 0); }
  }

  /* GLITCH EFFECT on h1 */
  .glitch { position: relative; }
  .glitch::before, .glitch::after {
    content: attr(data-text);
    position: absolute;
    top: 0; left: 0;
    font-family: var(--display);
    font-size: inherit;
    font-weight: 900;
    width: 100%;
  }
  .glitch::before { color: var(--cyan); animation: glitch 3.5s infinite; opacity: 0.5; }
  .glitch::after { color: var(--red); animation: glitch 3.5s infinite reverse; opacity: 0.3; }

  /* SCROLL REVEAL */
  .reveal { opacity: 0; transform: translateY(30px); transition: all 0.7s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    nav { padding: 16px 24px; }
    .nav-links { display: none; }
    .hero { padding: 0 6vw; padding-top: 80px; }
    .terminal-float { display: none; }
    .about-grid, .contact-inner { grid-template-columns: 1fr; }
    section { padding: 70px 6vw; }
    footer { flex-direction: column; gap: 12px; text-align: center; }
  }
</style>
</head>
<body>

<!-- Cursor -->
<div class="cursor" id="cursor"></div>
<div class="cursor-dot" id="cursorDot"></div>

<!-- Matrix Background -->
<canvas id="matrix-bg"></canvas>

<!-- NAV -->
<nav>
  <div class="nav-logo">CYBER<span>SEC</span></div>
  <ul class="nav-links">
    <li><a href="#skills">Skills</a></li>
